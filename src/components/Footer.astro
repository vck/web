---
import { SITE_ROLE, SITE_TITLE, SOCIALS } from '../consts';
const today = new Date();
---

<footer>
	<p class="foot-name">{SITE_TITLE} <span class="foot-role">— {SITE_ROLE}</span></p>
	<div class="foot-links">
		<a href={SOCIALS.github} target="_blank" rel="me">GitHub</a>
		<a href={SOCIALS.linkedin} target="_blank" rel="me">LinkedIn</a>
		<a href={SOCIALS.scholar} target="_blank" rel="me">Scholar</a>
		<a href={SOCIALS.email}>Email</a>
		<a href="/rss.xml">RSS</a>
	</div>
	<p class="foot-copy">&copy; {today.getFullYear()} {SITE_TITLE}</p>
</footer>
<style>
	footer {
		padding: 3em 1em;
		background: var(--paper);
		border-top: 1px solid var(--line);
		color: var(--muted);
		text-align: center;
	}
	.foot-name {
		margin: 0;
		color: var(--ink);
		font-weight: 700;
	}
	.foot-role {
		color: var(--muted);
		font-weight: 400;
	}
	.foot-links {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 0.25rem 1.5rem;
		margin-top: 1em;
	}
	.foot-links a {
		color: var(--muted);
		font-weight: 600;
		font-size: 0.92rem;
		text-decoration: none;
	}
	.foot-links a:hover {
		color: var(--accent);
	}
	.foot-copy {
		margin: 1.25em 0 0;
		font-size: 0.85rem;
	}
</style>
