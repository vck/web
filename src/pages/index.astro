---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE, SITE_ROLE, SOCIALS } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const personLd = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: SITE_TITLE,
	jobTitle: SITE_ROLE,
	url: Astro.site?.toString(),
	sameAs: [SOCIALS.github, SOCIALS.linkedin, SOCIALS.scholar],
};

---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<script type="application/ld+json" set:html={JSON.stringify(personLd)} />
	</head>
	<body>
		<Header />
		<section class="hero">
			<div class="wrap">
				<p class="eyebrow">Hello, I'm</p>
				<h1>Vicky Dasta</h1>
				<p class="subtitle">An <strong>AI researcher</strong> and <strong>computer vision engineer</strong>.</p>
				<p class="lede">
					I build vision systems that work in the real world — from edge inference pipelines
					and multi-object tracking to applied research that ships. Physics-trained, and I lead
					teams that take AI from lab to production.
				</p>
				<div class="cta-row">
					<a class="btn btn-solid" href="/blog">Read the blog</a>
					<a class="btn btn-ghost" href="/about">More about me</a>
				</div>
			</div>
		</section>
		<main class="wrap">
			<section class="home-section" aria-labelledby="focus-heading">
				<h2 class="section-title" id="focus-heading">What I do</h2>
				<p class="section-sub">The problems I keep coming back to, in the lab and in the field.</p>
				<div class="intro">
					<p>
						I work across the full vision stack. That starts with data — collecting from
						deployment cameras, auditing labels, and training detectors that hold up on
						footage the benchmarks never saw.
					</p>
					<p>
						Then comes inference where it actually runs: ONNX pipelines, careful quantization,
						and detect-sparse/track-dense designs on Jetson and CPU edge boxes. And around all
						of it, leading teams that take AI systems from architecture to production — CCTV
						intelligence, industrial sortation, and applied research that ships.
					</p>
					<ul class="intro-list">
						<li><strong>Training</strong> — field datasets, honest validation, models that survive deployment.</li>
						<li><strong>Inference</strong> — real-time perception on the hardware at hand.</li>
						<li><strong>Shipping</strong> — teams, pipelines, and systems in production.</li>
					</ul>
				</div>
			</section>
			<section class="home-section" aria-labelledby="research-heading">
				<h2 class="section-title" id="research-heading">Research</h2>
				<p class="section-sub">Physics-rooted questions I keep investigating.</p>
				<div class="intro">
					<p>
						Before production systems, there was a photonics lab: optics, signal processing,
						and computational physics applied to real measurement problems. That foundation
						still drives how I think about imaging — as physics first, models second.
					</p>
					<ul class="intro-list">
						<li><strong>Volumetric estimation</strong> — laser cross-sections and image processing for 3D measurement, my undergraduate thesis at Universitas Riau.</li>
						<li><strong>Spectral analysis</strong> — latent-variable methods (PCA, PLS) for extracting chemistry from high-dimensional spectra. <a href="/blog/latent-space-chemometrics/">Read the primer →</a></li>
						<li><strong>Field machine vision</strong> — taking lab-grade imaging ideas into orchards, ports, and factories, where the lighting never cooperates.</li>
					</ul>
				</div>
			</section>
			<section class="home-section" aria-labelledby="writing-heading">
				<h2 class="section-title" id="writing-heading">Writing</h2>
				<p class="section-sub">Notes on vision systems, inference, and training.</p>
				<ul class="post-rows">
					{
						posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									<span class="post-date">
										<FormattedDate date={post.data.pubDate} />
									</span>
									<span class="post-title">{post.data.title}</span>
								</a>
							</li>
						))
					}
				</ul>
				<a class="section-link" href="/blog">All posts →</a>
			</section>
		</main>
		<Footer />
	</body>
</html>
