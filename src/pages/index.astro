---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE, SITE_ROLE, SOCIALS } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const personLd = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: SITE_TITLE,
	jobTitle: SITE_ROLE,
	url: Astro.site?.toString(),
	sameAs: [SOCIALS.github, SOCIALS.linkedin, SOCIALS.scholar],
};

const focus = [
	{
		index: '01',
		title: 'Detection & Tracking',
		text: 'YOLOv8, ByteTrack, and multi-object tracking for CCTV intelligence and industrial sortation — vision that holds up in the field.',
	},
	{
		index: '02',
		title: 'Edge Inference',
		text: 'ONNX pipelines deployed on Jetson and CPU hardware. Real-time perception where the compute actually lives.',
	},
	{
		index: '03',
		title: 'Applied Research',
		text: 'Physics-rooted imaging — from laser cross-section volumetry to agentic LLM systems. Research that ships to production.',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<script type="application/ld+json" set:html={JSON.stringify(personLd)} />
	</head>
	<body>
		<Header />
		<section class="hero">
			<div class="wrap">
				<p class="eyebrow">Hello, I'm</p>
				<h1>Vicky Dasta</h1>
				<p class="subtitle">An <strong>AI researcher</strong> and <strong>computer vision engineer</strong>.</p>
				<p class="lede">
					I build vision systems that work in the real world — from edge inference pipelines
					and multi-object tracking to applied research that ships. Physics-trained, and I lead
					teams that take AI from lab to production.
				</p>
				<div class="cta-row">
					<a class="btn btn-solid" href="/blog">Read the blog</a>
					<a class="btn btn-ghost" href="/about">More about me</a>
				</div>
			</div>
		</section>
		<main class="wrap">
			<section class="home-section" aria-labelledby="focus-heading">
				<h2 class="section-title" id="focus-heading">What I do</h2>
				<p class="section-sub">The problems I keep coming back to, in the lab and in the field.</p>
				<ul class="cards">
					{
						focus.map((item) => (
							<li class="card">
								<span class="index">{item.index}</span>
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</li>
						))
					}
				</ul>
			</section>
			<section class="home-section" aria-labelledby="writing-heading">
				<h2 class="section-title" id="writing-heading">Writing</h2>
				<p class="section-sub">Notes on vision systems, inference, and training.</p>
				<ul class="post-rows">
					{
						posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									<span class="post-date">
										<FormattedDate date={post.data.pubDate} />
									</span>
									<span class="post-title">{post.data.title}</span>
								</a>
							</li>
						))
					}
				</ul>
				<a class="section-link" href="/blog">All posts →</a>
			</section>
		</main>
		<Footer />
	</body>
</html>
