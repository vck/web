---
import { getCollection } from 'astro:content';
import Search from 'astro-pagefind/components/Search.astro';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { slugifyTopic } from '../../utils/topics';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const topics = [...new Set(posts.flatMap((post) => post.data.tags))]
	.map((tag) => ({ tag, count: posts.filter((post) => post.data.tags.includes(tag)).length }))
	.sort((a, b) => b.count - a.count || a.tag.localeCompare(b.tag));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Blog — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<section class="page-hero">
			<div class="wrap">
				<p class="eyebrow">Writing</p>
				<h1>Blog</h1>
				<p class="lede">
					Notes on vision systems, edge deployment, and applied research —
					{posts.length} post{posts.length === 1 ? '' : 's'} and counting.
				</p>
			</div>
		</section>
		<main class="wrap">
			<div class="blog-search">
				<Search />
			</div>
			<ul class="topic-chips" aria-label="Browse by topic">
				{
					topics.map(({ tag, count }) => (
						<li>
							<a href={`/blog/topic/${slugifyTopic(tag)}/`}>
								{tag} <span class="count">({count})</span>
							</a>
						</li>
					))
				}
			</ul>
			<ul class="post-rows">
				{
					posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								<span class="post-date">
									<FormattedDate date={post.data.pubDate} />
								</span>
								<span class="post-text">
									<span class="post-title">{post.data.title}</span>
									<span class="post-desc">{post.data.description}</span>
									{
										post.data.tags.length > 0 && (
											<span class="post-tags">
												{post.data.tags.map((tag) => (
													<span>{tag}</span>
												))}
											</span>
										)
									}
								</span>
							</a>
						</li>
					))
				}
			</ul>
			<a class="section-link" href="/rss.xml">Subscribe via RSS →</a>
		</main>
		<Footer />
	</body>
</html>
